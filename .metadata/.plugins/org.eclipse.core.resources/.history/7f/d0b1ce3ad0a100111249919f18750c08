package day7;

public class Stack {
	 static void count(int n) {
		if (n == 0) {
			return;
		}
		System.out.println("Calling count(" + n + ")");
		count(n-1);
//		System.out.println("Returning from count(" + n + ")");
	}
	
	public static void main(String[] args) {
		System.out.println("abcd ");
		count(5);
		System.out.println("efgh ");
		
	}
}
