package day7;

public class binarySearchName {
	
	
	public static int binarySearchh(String[] arr, String target) {
		
		int left = 0;
		int right = arr.length - 1;
		while(left <= right) {
			int mid = (left + right) /2;
			System.out.println("Checking: " + arr[mid]);
			if(arr[mid].equals(target)) {
				return mid;
			}else if(arr[mid].compareTo(target) < 0) {
				 left = mid + 1;
			}else {
				right = mid - 1;
			}
		}
		return -1;
	}	
	
	
	public static void main(String[] args) {
		String[] names = {   "Aarav", "Ananya", "Karan", "Meera", "Rahul","Riya", "Sneha"};
		
		String target = "Riya";
		
		int  result = binarySearchh(names, target);
		
		if(result != -1) {
			System.out.println("Element found at index: " + result);
			
		}else {
			System.out.println("Element not found");
		}
	}
}
